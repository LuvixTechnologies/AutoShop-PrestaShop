# Copie ce fichier en .env.example puis adapte-le. Le .env.example ne doit JAMAIS être publié (il est dans .gitignore).
# Docker Compose et les scripts Python lisent ce même fichier.
# Changer DB_PASSWD, ADMIN_* ou PS_PORT après une première installation demande : python bootstrap.py --reset

# Boutique
PS_PORT=8080
PS_FOLDER_ADMIN=admin-dev

# Base de données (démo locale)
DB_NAME=prestashop
DB_PASSWD=change-me-db
DB_PREFIX=ps_

# Compte administrateur du back-office
ADMIN_MAIL=demo@example.com
ADMIN_PASSWD=ChangeMe_12345

# Clé API : laisse vide, bootstrap.py la génère et l'écrit ici (32 caractères A-Z et 0-9)
PS_API_KEY=

# Identité de la boutique (facultatif : prend le dessus sur shop.json)
SHOP_NAME=JDM Garage (démo)
SHOP_EMAIL=demo@example.com
SHOP_PHONE=
SHOP_ADDRESS=
SHOP_POSTCODE=
SHOP_CITY=
SHOP_LOGO_TEXT=JDM GARAGE

# Habillage (facultatif)
# Logo personnalisé (sinon assets/logo.png, sinon logo texte généré)
LOGO_PATH=
# Modules de démo à désactiver sur l'accueil (python shop_assets.py --list-home pour voir lesquels sont actifs)
HOME_DISABLE_MODULES=ps_banner,ps_imageslider,ps_customtext
